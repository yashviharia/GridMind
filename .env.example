# Copy to .env and fill in. Never commit .env.
# Data-center hosts: .in shown; use .com / .eu / .com.au / .jp / .sa / .ca to match your Catalyst account.
QUICKML_API_HOST=https://api.catalyst.zoho.in
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
QUICKML_PROJECT_ID=
QUICKML_ENDPOINT_KEY=
QUICKML_ENVIRONMENT=Development
ZOHO_ORG_ID=
# OAuth: ZOHO_ACCESS_TOKEN (1 hour, quick tests) or the Self Client trio below (auto-renews)
ZOHO_ACCESS_TOKEN=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Optional persistence on Catalyst (otherwise in-memory)
GRIDMIND_STORAGE=memory
GRIDMIND_TABLE=ForecastRuns
GRIDMIND_BUCKET=

# predict.py: public URL of the deployed app's prediction API
GRIDMIND_PREDICT_URL=
